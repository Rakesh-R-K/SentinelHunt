# =============================================
# SentinelHunt Environment Configuration
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables are optional — the platform runs
# with sensible defaults when they're not set.

# ── Redis (Real-time Streaming) ──────────────
SENTINELHUNT_REDIS_HOST=localhost
SENTINELHUNT_REDIS_PORT=6379
SENTINELHUNT_REDIS_PASSWORD=

# ── Authentication ───────────────────────────
# Change this in production! Used to sign JWT tokens.
SENTINELHUNT_JWT_SECRET=change-this-in-production

# ── Threat Intelligence API Keys ─────────────
# Get free keys from:
#   VirusTotal: https://www.virustotal.com/gui/join-us
#   AbuseIPDB:  https://www.abuseipdb.com/register
#   Shodan:     https://account.shodan.io/register
SENTINELHUNT_VT_API_KEY=
SENTINELHUNT_ABUSEIPDB_KEY=
SENTINELHUNT_SHODAN_KEY=

# ── Logging ──────────────────────────────────
SENTINELHUNT_LOG_LEVEL=INFO

# ── API Server ───────────────────────────────
PORT=5000
NODE_ENV=development
